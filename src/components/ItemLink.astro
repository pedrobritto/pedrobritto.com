---
const { href, name, description, active } = Astro.props;
---

<a
  href={href}
  target="_blank"
  class="group mb-4 block border-b border-dotted border-stone-300 pb-4">
  <div class="font-medium transition-all group-hover:text-red-700">
    {name}
  </div>
  <div class="text-stone-500 transition-all group-hover:text-stone-600">
    {description}
  </div>
</a>
