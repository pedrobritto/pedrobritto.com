---
const { href, name, description, badge } = Astro.props;
---

<a
  href={href}
  target="_blank"
  class="group mb-4 block border-b border-dotted border-stone-300 pb-4 dark:border-stone-700">
  <div
    class="font-bold transition-all group-hover:text-red-700 dark:group-hover:text-red-400">
    {name}
  </div>
  <div
    class="text-base text-stone-500 transition-all dark:text-stone-400">
    {description}
  </div>
</a>
