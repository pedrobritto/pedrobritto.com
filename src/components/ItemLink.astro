---
interface Props {
  href: string;
  name: string;
  description: string;
  yearStart?: string;
  yearEnd?: string;
}

const { href, name, description, yearStart, yearEnd } = Astro.props;
---

<a
  href={href}
  target="_blank"
  class="group block border-b editorial-rule py-6">
  <div class="flex items-center gap-4">
    <div
      class="font-serif text-2xl font-semibold transition-colors group-hover:text-accent-warm">
      {name}
    </div>

    {
      yearStart && yearEnd && (
        <div class="text-xs uppercase tracking-[0.16em] text-ink-muted">
          {yearStart} → {yearEnd}
        </div>
      )
    }
  </div>
  <div class="mt-2 max-w-2xl font-serif text-lg leading-relaxed text-ink-muted">
    {description}
  </div>
</a>
