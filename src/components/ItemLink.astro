---
const { href, name, description, active } = Astro.props;
---

<a
  href={href}
  target="_blank"
  class="group mb-4 block border-b border-dotted border-stone-300 pb-4 dark:border-stone-700">
  <div
    class="font-medium transition-all group-hover:text-red-700 dark:group-hover:text-red-400">
    {name}
  </div>
  <div
    class="text-stone-500 transition-all group-hover:text-stone-600 dark:text-stone-400 dark:group-hover:text-stone-300">
    {description}
  </div>
</a>
