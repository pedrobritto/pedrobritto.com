---
const { title, seeAllUrl } = Astro.props;
---

<section>
  <div class="mb-6">
    <h2 class="font-serif text-3xl font-medium">{title}</h2>
  </div>

  <div>
    <slot />
  </div>

  {
    seeAllUrl && (
      <a href={seeAllUrl} class="font-bold">
        See all &rarr;
      </a>
    )
  }
</section>
