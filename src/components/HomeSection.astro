---
interface Props {
  title?: string;
  seeAllUrl?: string;
}

const { title, seeAllUrl } = Astro.props;
---

<section class:list={[title ? "pt-10" : ""]}>
  {
    title && (
      <div class="mb-8 flex flex-col gap-6 sm:flex-row sm:items-end">
        <h2 class="text-ink font-serif text-4xl leading-none md:text-5xl">
          {title}
        </h2>

        {seeAllUrl && (
          <a
            href={seeAllUrl}
            class="text-ink-muted text-sm tracking-[0.18em] uppercase">
            See all
          </a>
        )}
      </div>
    )
  }

  <div>
    <slot />
  </div>
</section>
