---
interface Props {
  title?: string;
  seeAllUrl?: string;
}

const { title, seeAllUrl } = Astro.props;
---

<section class:list={[title ? "border-t editorial-rule pt-10" : ""]}>
  {
    title && (
      <div class="mb-8 flex items-end justify-between gap-6">
        <h2 class="font-serif text-4xl md:text-5xl leading-none text-ink">
          {title}
        </h2>

        {seeAllUrl && (
          <a
            href={seeAllUrl}
            class="text-xs uppercase tracking-[0.18em] text-ink-muted">
            See all
          </a>
        )}
      </div>
    )
  }

  <div>
    <slot />
  </div>
</section>
