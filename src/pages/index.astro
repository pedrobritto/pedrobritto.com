---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import BlogPostLink from "../components/BlogPostLink.astro";
import ItemLink from "../components/ItemLink.astro";
import HomeSection from "../components/HomeSection.astro";

const projectItems = [
  {
    name: "Set Tracker",
    description: "Track your sets and rest times for your exercises.",
    href: "https://settracker.pedrobritto.com",
  },
  {
    name: "Price per volume",
    description: "Compare prices of different products per volume or weight.",
    href: "https://precos.pedrobritto.com",
  },
  {
    name: "Life in Dots",
    description: "Type in your birthdate and see your life in dots.",
    href: "https://lifeindots.pedrobritto.com",
  },
];

const latestBlogPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout
  title="Pedro Britto | Software Engineer"
  description="Software Engineering and other human endeavors.">
  <main class="">
    <Container>
      <div class="space-y-14">
        <HomeSection title="">
          <div class="space-y-6">
            <div class="">
              <h1 class="inline font-bold">
                I'm a Software Engineer with 8 years of experience,
              </h1>
              <p class="inline text-pretty">
                specialized in building performant and pixel perfect User
                Interfaces using TypeScript, Next.js, React and other tools.
              </p>
            </div>

            <p class="">
              You can find me at <a
                href="https://www.linkedin.com/in/pedro-britto/"
                class="underline">LinkedIn</a
              >, <a href="https://github.com/pedrobritto" class="underline"
                >GitHub</a
              > and
              <a href="https://x.com/pibritto/" class="underline">X</a>.
            </p>
          </div>
        </HomeSection>

        <HomeSection title="Latest from Blog" seeAllUrl="/blog">
          {
            latestBlogPosts.length > 0 ? (
              latestBlogPosts.map((post) => (
                <BlogPostLink
                  name={post.data.title}
                  href={`/blog/${post.id}`}
                  description={post.data.description}
                  date={post.data.pubDate}
                />
              ))
            ) : (
              <p class="mb-4 italic">No blog posts yet.</p>
            )
          }
        </HomeSection>

        <HomeSection title="Personal Projects" seeAllUrl="/projects">
          {projectItems.map((item) => <ItemLink {...item} />)}
        </HomeSection>
      </div>
    </Container>
  </main>
</BaseLayout>
