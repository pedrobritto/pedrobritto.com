---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import ItemLink from "../components/ItemLink.astro";
import HomeSection from "../components/HomeSection.astro";

const workItems = [
  {
    name: "Petco Love",
    description:
      "A nonprofit saving pet lives through adoption, reunification, and grants.",
    href: "https://petcolove.org/lost",
    active: true,
  },
  {
    name: "Petco.com",
    description:
      "A pet health and wellness company offering products, services, and vet care.",
    href: "https://petco.com/",
  },
  {
    name: "AirVet",
    description:
      "24/7 virtual vet care connecting pet owners to licensed veterinarians.",
    href: "https://airvet.com/",
  },
  {
    name: "Amazing Athletes",
    description:
      "Youth sports programs building fitness, skills, and confidence.",
    href: "https://amazingathletes.com/",
  },
];

const projectItems = [
  {
    name: "Set Tracker",
    description: "Track your sets and rest times for your exercises.",
    href: "https://settracker.pedrobritto.com",
  },
  {
    name: "Price per volume",
    description: "Compare prices of different products per volume or weight.",
    href: "https://precos.pedrobritto.com",
  },
  {
    name: "Life in Dots",
    description: "Type in your birthdate and see your life in dots.",
    href: "https://lifeindots.pedrobritto.com",
  },
];
---

<BaseLayout
  title="Pedro Britto | Software Engineer"
  description="Software Engineering and other human endeavors.">
  <main class="">
    <Container>
      <div class="space-y-14">
        <HomeSection title="">
          <div class="space-y-6 leading-[1.7]">
            <div class="">
              <h1 class="inline font-bold">
                I'm a Software Engineer with 8 years of experience.
              </h1>
              <p class="inline text-pretty">
                Expert in building performant and pixel perfect front-ends using
                TypeScript, Next.js, React and other tools. Currently working
                with <a href="https://petcolove.org/lost/" class="underline"
                  >Petco Love</a
                >.
              </p>
            </div>

            <p class="">
              You can find me at <a
                href="https://www.linkedin.com/in/pedro-britto/"
                class="underline">LinkedIn</a
              >, <a href="https://github.com/pedrobritto" class="underline"
                >GitHub</a
              > and
              <a href="https://x.com/pibritto/" class="underline">X</a>.
            </p>

            <!-- <p class="">
              <a href="/resume" class="underline">Click here for my resume</a>.
            </p> -->
          </div>
        </HomeSection>

        <HomeSection title="Latest Posts">
          <div>Soon</div>
        </HomeSection>

        <HomeSection title="Personal Projects">
          {projectItems.map((item) => <ItemLink {...item} />)}
        </HomeSection>
      </div>
    </Container>
  </main>
</BaseLayout>
