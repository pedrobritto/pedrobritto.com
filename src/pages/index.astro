---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import BlogPostLink from "../components/BlogPostLink.astro";
import ItemLink from "../components/ItemLink.astro";
import HomeSection from "../components/HomeSection.astro";

const projectItems = [
  {
    name: "Set Tracker",
    description: "Track your sets and rest times for your exercises.",
    href: "https://settracker.pedrobritto.com",
  },
  {
    name: "Price per volume",
    description: "Compare prices of different products per volume or weight.",
    href: "https://precos.pedrobritto.com",
  },
  {
    name: "Life in Dots",
    description: "Type in your birthdate and see your life in dots.",
    href: "https://lifeindots.pedrobritto.com",
  },
];

const latestBlogPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 10);
---

<BaseLayout
  title="Pedro Britto | Software Engineer"
  description="Software Engineering and other human endeavors.">
  <main>
    <Container>
      <div class="space-y-20 py-14 sm:py-20">
        <HomeSection title="">
          <div class="max-w-4xl">
            <div class="font-serif leading-tight text-ink tracking-tight space-y-4 md:space-y-6">
              <h1 class="text-5xl italic">
                Hi, I'm <span class="text-ink font-semibold">Pedro&nbsp;Britto</span>.
              </h1>

              <div class="text-4xl md:text-5xl text-ink-muted">
                A <span class="text-ink">Software Engineer</span>,
                specialized in building pretty and performant <span class="text-ink">user interfaces</span>. Currently helping reunite lost pets at <a href="https://petcolove.org/lost" class="underline italic decoration-1 underline-offset-4 text-ink">Petco Love</a>
              </div>

              <div class="font-sans text-ink-muted">I also like Writing (besides programming), Reading sci-fi, Baking breads, Cooking in general, and fixing things.</div>
            </div>
          </div>
        </HomeSection>

        <HomeSection title="Latest from Blog" seeAllUrl="/blog">
          {
            latestBlogPosts.length > 0 ? (
              latestBlogPosts.map((post, index) => (
                <BlogPostLink
                  name={post.data.title}
                  href={`/blog/${post.id}`}
                  description={post.data.description}
                  date={post.data.pubDate}
                  index={index + 1}
                />
              ))
            ) : (
              <p class="font-serif text-ink-muted italic">No blog posts yet.</p>
            )
          }
        </HomeSection>

        <HomeSection title="Personal Projects" seeAllUrl="/projects">
          {projectItems.map((item) => <ItemLink {...item} />)}
        </HomeSection>
      </div>
    </Container>
  </main>
</BaseLayout>
