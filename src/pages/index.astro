---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import BlogPostLink from "../components/BlogPostLink.astro";
import ItemLink from "../components/ItemLink.astro";
import HomeSection from "../components/HomeSection.astro";

const projectItems = [
  {
    name: "Set Tracker",
    description: "Track your sets and rest times for your exercises.",
    href: "https://settracker.pedrobritto.com",
  },
  {
    name: "Price per volume",
    description: "Compare prices of different products per volume or weight.",
    href: "https://precos.pedrobritto.com",
  },
  {
    name: "Life in Dots",
    description: "Type in your birthdate and see your life in dots.",
    href: "https://lifeindots.pedrobritto.com",
  },
];

const latestBlogPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 10);
---

<BaseLayout
  title="Pedro Britto | Software Engineer"
  description="Software Engineering and other human endeavors.">
  <main>
    <Container>
      <div class="space-y-20 py-14 sm:py-20">
        <HomeSection title="">
          <div>
            <div
              class="text-ink space-y-4 font-serif leading-tight tracking-tight md:space-y-6">
              <h1 class="text-5xl">
                Hi, I'm <span class="text-ink font-semibold"
                  >Pedro&nbsp;Britto</span
                >!
              </h1>

              <div class="text-ink-muted text-3xl md:text-4xl">
                <p>
                  A <span class="text-ink">Software Engineer</span>, specialized
                  in building pretty and performant <span class="text-ink"
                    >user interfaces</span
                  >.
                </p>

                <p class="mt-4">
                  Currently helping reunite lost pets at <a
                    href="https://petcolove.org/lost"
                    class="text-ink underline decoration-1 underline-offset-4"
                    >Petco Love</a
                  >
                </p>
              </div>

              <div class="text-ink-muted font-sans">
                I also enjoy writing, reading sci-fi, baking bread, cooking, and
                fixing things.
              </div>
            </div>
          </div>
        </HomeSection>

        <HomeSection title="Personal Projects" seeAllUrl="/projects">
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            {projectItems.map((item) => <ItemLink {...item} />)}
          </div>
        </HomeSection>

        <HomeSection title="Latest from Blog" seeAllUrl="/blog">
          {
            latestBlogPosts.length > 0 ? (
              latestBlogPosts.map((post, index) => (
                <BlogPostLink
                  name={post.data.title}
                  href={`/blog/${post.id}`}
                  description={post.data.description}
                  date={post.data.pubDate}
                  index={index + 1}
                />
              ))
            ) : (
              <p class="text-ink-muted font-serif">No blog posts yet.</p>
            )
          }
        </HomeSection>
      </div>
    </Container>
  </main>
</BaseLayout>
