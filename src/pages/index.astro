---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";

const workItems = [
  {
    name: "Petco Love",
    description:
      "A nonprofit saving pet lives through adoption, reunification, and grants",
    href: "https://petcolove.org/lost",
    active: true,
  },
  {
    name: "Petco.com",
    description:
      "A pet health and wellness company offering products, services, and vet care",
    href: "https://petco.com/",
  },
  {
    name: "AirVet",
    description:
      "24/7 virtual vet care connecting pet owners to licensed veterinarians",
    href: "https://airvet.com/",
  },
  {
    name: "Amazing Athletes",
    description:
      "Youth sports programs building fitness, skills, and confidence",
    href: "https://amazingathletes.com/",
  },
];

const projectItems = [
  {
    name: "Set Tracker",
    description: "Track your sets and rest times for your exercises",
    href: "https://settracker.pedrobritto.com",
  },
  {
    name: "Price per volume",
    description: "Compare prices of different products per volume or weight",
    href: "https://precos.pedrobritto.com",
  },
  {
    name: "Life in Dots",
    description: "Type in your birthdate and see your life in dots",
    href: "https://lifeindots.pedrobritto.com",
  },
];
---

<BaseLayout
  title="Pedro Britto | Software Engineer"
  description="8+ YoE in Web Development">
  <main class="">
    <Container>
      <div>
        <h1>Software Engineer with 8 years of experience.</h1>
      </div>

      <section class="mt-10">
        <h2 class="text-2xl font-medium italic">Latest Posts</h2>

        <div>See all...</div>
      </section>

      <section class="mt-10">
        <h2 class="mb-6 text-2xl font-medium italic">Projects</h2>

        <div class="grid">
          {
            projectItems.map((item) => (
              <a href={item.href} class="group border-b border-dotted border-stone-300 mb-4 pb-4">
                <div class="font-bold group-hover:text-red-700 transition-all">{item.name}</div>
                <div class="text-stone-500 group-hover:text-stone-600 transition-all">{item.description}</div>
              </a>
            ))
          }
        </div>
      </section>
    </Container>
  </main>
</BaseLayout>
