---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import ItemLink from "../components/ItemLink.astro";
import HomeSection from "../components/HomeSection.astro";

const workItems = [
  {
    name: "Petco Love",
    description:
      "A nonprofit saving pet lives through adoption, reunification, and grants.",
    href: "https://petcolove.org/lost",
    active: true,
  },
  {
    name: "Petco.com",
    description:
      "A pet health and wellness company offering products, services, and vet care.",
    href: "https://petco.com/",
  },
  {
    name: "AirVet",
    description:
      "24/7 virtual vet care connecting pet owners to licensed veterinarians.",
    href: "https://airvet.com/",
  },
  {
    name: "Amazing Athletes",
    description:
      "Youth sports programs building fitness, skills, and confidence.",
    href: "https://amazingathletes.com/",
  },
];

const projectItems = [
  {
    name: "Set Tracker",
    description: "Track your sets and rest times for your exercises.",
    href: "https://settracker.pedrobritto.com",
  },
  {
    name: "Price per volume",
    description: "Compare prices of different products per volume or weight.",
    href: "https://precos.pedrobritto.com",
  },
  {
    name: "Life in Dots",
    description: "Type in your birthdate and see your life in dots.",
    href: "https://lifeindots.pedrobritto.com",
  },
];
---

<BaseLayout
  title="Pedro Britto | Software Engineer"
  description="8+ YoE in Web Development">
  <main class="">
    <Container>
      <HomeSection title="Work Experience">
        <h1 class="inline font-bold">
          Software Engineer with 8 years of experience.
        </h1>
        <p class="inline">
          Expertise in front-end development using TypeScript, Next.js, React
          and other tools. Currently working at <a
            href="https://petcolove.org/lost/"
            class="underline">Petco Love</a
          >.
        </p>

        <p class="mt-4">
          <a href="/resume" class="underline">Click here for my full resume</a>.
        </p>
      </HomeSection>

      <HomeSection title="Latest Posts">
        <div>See all...</div>
      </HomeSection>

      <HomeSection title="Personal Projects">
        {projectItems.map((item) => <ItemLink {...item} />)}
      </HomeSection>
    </Container>
  </main>
</BaseLayout>
